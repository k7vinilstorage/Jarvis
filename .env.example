# Copie para .env e preencha:  cp .env.example .env
# O passo 2 de docs/fase0.md gera as chaves automaticamente.

# ---- Geral ----
TZ=America/Sao_Paulo
# Arquivos do compose. A voz (Fase 2) acrescenta :docker-compose.voz.yml; o Honcho, :docker-compose.honcho.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.tools.yml

# ---- Ollama ----
# Nome do volume onde o seu Ollama atual guarda os modelos (passo 3 do guia)
OLLAMA_VOLUME=ollama
BASE_MODEL=qwen3.5:4b
JARVIS_MODEL=jarvis-qwen
JARVIS_NUM_CTX=65536
# Camadas do modelo na GPU. 99 = todas (força 100% GPU). Vazio = o Ollama decide sozinho.
JARVIS_NUM_GPU=99
# Amostragem. Mais baixo = mais fiel ao que as ferramentas devolvem, menos invenção.
# O padrão do qwen3.5 é temperatura 1, top_p 0.95, presence_penalty 1.5. Vazio = o padrão do modelo.
# Para mudar e aplicar de uma vez: ./scripts/modelo.sh ajustar temperatura 0.3
JARVIS_TEMPERATURE=0.5
JARVIS_TOP_P=0.9
JARVIS_TOP_K=20
JARVIS_PRESENCE_PENALTY=0.3

# ---- Hermes ----
# Chave da API (gerada com: openssl rand -hex 32)
HERMES_API_KEY=
# Seu usuário no servidor (id -u / id -g): assim você edita os arquivos do Hermes sem sudo
HERMES_UID=1000
HERMES_GID=1000
# Login do painel web (porta 9119)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=

# ---- Voz ----
# small-int8 é o equilíbrio para CPU; medium-int8 acerta mais o português, mas é mais lento
WHISPER_MODEL=small-int8
# Outras vozes pt_BR para testar: pt_BR-cadu-medium, pt_BR-jeff-medium
# Amostras: https://rhasspy.github.io/piper-samples/
PIPER_VOICE=pt_BR-faber-medium

# ---- Ferramentas do Jarvis (jarvis-tools, docs/fase1.md) ----
# Token entre o Hermes e o jarvis-tools (o scripts/fase1-jarvis-tools.sh gera)
JARVIS_TOOLS_TOKEN=
# Cidade padrão da previsão do tempo. Entre aspas, porque o .env também é lido pelo bash
JARVIS_CIDADE="Cornélio Procópio, PR"
# Moodle da faculdade (o login é feito com: docker compose exec -it jarvis-tools python -m app.moodle_login)
MOODLE_URL=https://moodle.utfpr.edu.br
# Conta Google usada para criar eventos quando você não diz qual (rótulo do google_login). Vazio = a primeira.
GOOGLE_CONTA_PADRAO=
# Busca na web: o scripts/fase1-jarvis-tools.sh preenche estas duas se achar o contêiner searxng
# e acrescenta :docker-compose.searxng.yml ao COMPOSE_FILE
SEARXNG_URL=
SEARXNG_REDE=
# O que nunca vai para uma busca na web: o seu nome, sobrenome e apelidos, separados por vírgula (os e-mails das
# contas Google já entram sozinhos). Palavra inteira: um nome comum sozinho bloquearia buscas como "João Pessoa".
# Exemplo: JARVIS_TERMOS_PRIVADOS="Fulano de Tal, Tal"
JARVIS_TERMOS_PRIVADOS=

# ---- Ponte de voz (jarvis-voz, docs/fase2.md) ----
# Token do PC e do ESP32 para falar com a ponte (o scripts/fase2-voz.sh gera)
JARVIS_VOZ_TOKEN=
# Porta na rede de casa (nunca redirecione no roteador)
JARVIS_VOZ_PORTA=10800
# IP do servidor na rede de casa (ex.: 192.168.0.10): a porta só escuta nele. Vazio = todas as placas de rede
JARVIS_VOZ_IP=

# ---- Honcho: memória de longo prazo (opcional, ver docs/honcho.md) ----
# Para ativar, acrescente :docker-compose.honcho.yml ao COMPOSE_FILE lá em cima
HONCHO_VERSION=v3.2.1
# Gere com: openssl rand -hex 16
HONCHO_DB_PASSWORD=
# Modelo de embeddings (multilíngue, 1024 dimensões). Trocar exige ajustar honcho/honcho.env
HONCHO_EMBED_BASE=bge-m3
