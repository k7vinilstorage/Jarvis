# Configuração do Honcho (memória de longo prazo do Jarvis).
# Copie para honcho/honcho.env:  cp honcho/honcho.env.example honcho/honcho.env
#
# Tudo roda localmente: o Honcho usa o mesmo Ollama do Jarvis.
#   - LLM (deriver, dialético, resumos, "sonhos"): jarvis-qwen, na GPU
#   - embeddings: jarvis-embed (bge-m3 multilíngue), na CPU, para não ocupar VRAM
# O banco (Postgres) e o Redis são definidos no docker-compose.honcho.yml.

# ---- Geral ----
LOG_LEVEL=INFO
# Sem autenticação: a API do Honcho só é acessível pela rede interna do Docker
AUTH_USE_AUTH=false
SENTRY_ENABLED=false
CACHE_ENABLED=true

# ---- LLM ----
# O Ollama não confere a chave, mas o cliente OpenAI exige uma preenchida.
LLM_OPENAI_API_KEY=ollama

# Deriver: lê as conversas em segundo plano e extrai fatos sobre você
DERIVER_WORKERS=1
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=jarvis-qwen
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
# Se o deriver processar mensagens mas nunca gerar observações, descomente
# (o Ollama às vezes ignora o formato json_schema):
# DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object

# Resumos de sessão
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=jarvis-qwen
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1

# "Sonhos": consolidação quando você fica 60 min sem conversar
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=jarvis-qwen
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=jarvis-qwen
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1

# Dialético: responde ao Hermes "o que sei sobre este usuário?"
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=jarvis-qwen
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=jarvis-qwen
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=jarvis-qwen
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=jarvis-qwen
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=jarvis-qwen
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1

# ---- Embeddings ----
# Precisa bater com HONCHO_EMBED_MODEL / HONCHO_EMBED_DIMS do .env principal.
# Trocar de modelo depois exige recriar o banco do Honcho (docs/honcho.md).
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=jarvis-embed
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=never
EMBEDDING_VECTOR_DIMENSIONS=1024
EMBEDDING_MAX_INPUT_TOKENS=8192
